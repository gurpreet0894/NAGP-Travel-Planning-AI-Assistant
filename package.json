{
  "name": "ai-travel-planning-assistant",
  "version": "1.0.0",
  "description": "AI Travel Planning Assistant for Singapore - RAG knowledge base + MCP tools (weather, currency) powered by Google Gemini",
  "type": "module",
  "private": true,
  "scripts": {
    "ingest": "tsx src/scripts/ingest.ts",
    "eval": "tsx src/scripts/evaluate.ts",
    "dev": "tsx watch src/server/index.ts",
    "start": "node --import tsx src/server/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "mcp:weather": "node --import tsx src/mcp/servers/weatherServer.ts",
    "mcp:currency": "node --import tsx src/mcp/servers/currencyServer.ts"
  },
  "dependencies": {
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.2.11",
    "@langchain/google-genai": "^2.3.0",
    "@langchain/langgraph": "^1.4.15",
    "@langchain/textsplitters": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "faiss-node": "^0.5.1",
    "gray-matter": "^4.0.3",
    "langchain": "^1.5.11",
    "uuid": "^11.1.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
